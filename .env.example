# ==========================================================================
# Production Support Toolbox — environment template
# Copy to .env (gitignored) and fill in the values for your machine.
# ==========================================================================

# --- Privacy / redaction ---
# Sensitive values (password, token, authorization, api_key, ...) are masked
# in /api/tools/analyze responses by default. Set to "off" to disable.
# PST_REDACT=off

# --- AI fallback (Hybrid Pattern — OPT-IN) ---
# When the rule engine matches NOTHING, falls back to an LLM for a structured
# bilingual analysis of the same masked context. Default OFF; requires a key.
# PST_AI_FALLBACK=true
# OPENROUTER_API_KEY=sk-or-...
# PST_OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
# PST_OPENROUTER_TIMEOUT_S=120
# PST_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Incident dossier ---
# /api/tools/analyze recalls past incidents for the same system from the
# local Support History. Set to "off" to disable.
# PST_DOSSIER=off

# --- Auto-backup (Phase 2) ---
# Set to "off" to disable daily JSON snapshots.
# PST_AUTO_BACKUP=off