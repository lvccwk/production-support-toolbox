# ==========================================================================
# Production Support Toolbox — environment template
# Copy to .env (gitignored) and fill in the values for your machine.
# ==========================================================================

# --- LLM master switch ---
# All LLM features are OFF until this is true.
PST_LLM_ENABLED=false

# --- OpenRouter (the LLM transport) ---
# API key stays server-side in .env — never sent to the browser.
OPENROUTER_API_KEY=
# Model id — use the exact slug shown in your OpenRouter Models page,
# e.g. deepseek/deepseek-flash-v4 or openrouter/anthropic/claude-3.5-sonnet.
PST_OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
# Hard timeout per analysis in seconds. Reasoning models can take a minute+
# on a long prompt, so keep this at 180+ (or 240 for slow providers).
PST_OPENROUTER_TIMEOUT_S=180
# Max output tokens (reasoning models need headroom for the final JSON).
PST_OPENROUTER_MAX_TOKENS=4096
# Optional API base override (default https://openrouter.ai/api/v1).
# PST_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Auto-backup (Phase 2) ---
# Set to "off" to disable daily JSON snapshots.
# PST_AUTO_BACKUP=off