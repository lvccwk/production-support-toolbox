# ==========================================================================
# Production Support Toolbox — environment template
# Copy to .env (gitignored) and fill in the values for your machine.
# ==========================================================================

# --- Privacy / redaction ---
# Sensitive values (password, token, authorization, api_key, ...) are masked
# in /api/tools/analyze responses by default. Set to "off" to disable.
# PST_REDACT=off

# --- Incident dossier ---
# /api/tools/analyze recalls past incidents for the same system from the
# local Support History. Set to "off" to disable.
# PST_DOSSIER=off

# --- Auto-backup (Phase 2) ---
# Set to "off" to disable daily JSON snapshots.
# PST_AUTO_BACKUP=off