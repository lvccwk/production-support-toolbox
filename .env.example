# ==========================================================================
# Production Support Toolbox — environment template
# Copy to .env (gitignored) and fill in the values for your machine.
# ==========================================================================

# --- OpenCode integration (Phase 3) ---
# Master switch. All LLM features are OFF until this is true AND opencode
# is installed (https://opencode.ai).
PST_LLM_ENABLED=false

# opencode executable (name on PATH, or absolute path).
PST_OPNCODE_BIN=opencode

# Hard timeout per analysis in seconds (agent runs are slow).
PST_OPNCODE_TIMEOUT_S=120

# Sandbox working directory where the agent process is spawned.
# NEVER point this at a directory containing real files.
PST_OPNCODE_WORKDIR=./data/opencode-workdir

# Optional: override the model OpenCode uses (version-dependent flag).
PST_OPNCODE_MODEL=

# Auto-backup (Phase 2). Set to "off" to disable daily JSON snapshots.
# PST_AUTO_BACKUP=off

# --- Model provider keys (OpenCode reads these itself) ---
# Enable at least one. For local models (Ollama) no key is needed.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...